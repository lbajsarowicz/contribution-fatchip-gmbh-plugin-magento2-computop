{
    "name": "fatchip-gmbh/plugin-magento2-computop",
    "description": "FATCHIP Computop Payment Plugin",
    "type": "magento2-module",
    "version": "1.3.3",
    "license": "MIT",
    "require": {
        "php": ">=7.4.0",
        "magento/framework": ">=100.3.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Fatchip\\Computop\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
